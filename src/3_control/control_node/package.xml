<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control_node</name>
  <version>0.0.0</version>
  <description>ROS 2 control node for vehicle actuation, path following, and estimation.</description>
  <maintainer email="simonebondi456@gmail.com">simonebondi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>mmr_base</depend>
  <depend>mmr_edf</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
